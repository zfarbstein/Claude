# Copy to .env.local. Local values come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
VITE_APP_NAME=Chapter Calendar
# Web Push public key from `npm run vapid` (README "Excuses and notifications"). Without it, notifications go to the in-app bell and email.
# VITE_VAPID_PUBLIC_KEY=
# Optional: share the login across subdomains of one parent domain (see README "Hub apps").
# VITE_AUTH_COOKIE_DOMAIN=.yourchapter.org

# Local Supabase only (read by supabase/config.toml)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
